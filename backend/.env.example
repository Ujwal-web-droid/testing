# ─── WebGuard AI — Backend Environment Variables Template ────────
# Copy this file to .env for local development.
# In Railway production, set these directly in Railway Service Variables.

# Application Environment ('development' or 'production')
ENVIRONMENT=development
DEBUG=true

# Database Connection (Railway PostgreSQL will provide DATABASE_URL)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://webguard:webguard@localhost:5432/webguard_db

# JWT Authentication
# In production: generate a 64-character hex key using `openssl rand -hex 64`
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
# Comma-separated list or JSON array of origins permitted to communicate with backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Scanner Settings
SCAN_TIMEOUT_SECONDS=15
SCAN_MAX_CONCURRENT=5
SENSITIVE_FILE_PROBE_DELAY_MS=200

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_CRON_HOUR=2
SCHEDULER_CRON_MINUTE=0

# Trust Seal Public URL
SEAL_PUBLIC_BASE_URL=http://localhost:3000/seal
